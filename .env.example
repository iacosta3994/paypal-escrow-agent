# PayPal sandbox (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# ^ When set, the webhook listener verifies every delivery's
#   signature with PayPal before trusting it. Leave empty for local
#   fixture-mode testing; set it before exposing the listener.

# LLM for the decision engine
# Tier 1: Laya forest (local, $0) — no key needed, pip install laya
# Tier 2: Grok via xAI (only for hard cases)
LLM_TIER2_MODEL=grok-4
XAI_API_KEY=

# App
DASHBOARD_PORT=5000
AUDIT_LOG_PATH=./audit.log.jsonl
